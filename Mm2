RunService.RenderStepped:Connect(function()
	if not espEnabled then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character and p.Character:FindFirstChild("Head") then
			local pos, onScreen = cam:WorldToViewportPoint(p.Character.Head.Position + Vector3.new(0,2.5,0))
			if onScreen then
				if not espTexts[p] then
					local t = Drawing.new("Text")
					t.Center = true
					t.Outline = true
					t.Size = 16
					espTexts[p] = t
				end
				local role = getRole(p)
				espTexts[p].Text = p.Name .. " [" .. role .. "]"
				espTexts[p].Color = roleColors[role]
				espTexts[p].Position = Vector2.new(pos.X, pos.Y)
				espTexts[p].Visible = true
			elseif espTexts[p] then
				espTexts[p].Visible = false
			end
		elseif espTexts[p] then
			espTexts[p].Visible = false
		end
	end
end)
