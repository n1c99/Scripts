local function hasTool(player, toolNames)
	for _, name in ipairs(toolNames) do
		if (player.Character and player.Character:FindFirstChild(name))
			or (player.Backpack and player.Backpack:FindFirstChild(name)) then
			return true
		end
	end
	return false
end

local function getRole(player)
	if hasTool(player, {"Knife"}) then return "Murderer" end
	if hasTool(player, {"Gun", "Revolver"}) then return "Sheriff" end
	return "Innocent"
end

local function getMurderer()
	for _, v in ipairs(Players:GetPlayers()) do
		if v ~= lp and v.Character then
			if v.Character:FindFirstChild("Knife") or v.Backpack:FindFirstChild("Knife") then
				return v
			end
		end
	end
end

local function getSheriff()
	for _, v in ipairs(Players:GetPlayers()) do
		if v ~= lp and v.Character then
			if v.Character:FindFirstChild("Gun") or v.Character:FindFirstChild("Revolver")
				or v.Backpack:FindFirstChild("Gun") or v.Backpack:FindFirstChild("Revolver") then
				return v
			end
		end
	end
end

local function fling(TargetPlayer)
	if not TargetPlayer or not TargetPlayer.Character then return end

	local Character = lp.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart

	local TCharacter = TargetPlayer.Character
	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
	if not THumanoid or THumanoid.Health <= 0 then return end

	local TRootPart = THumanoid.RootPart
	local THead = TCharacter:FindFirstChild("Head")
	local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
	local Handle = Accessory and Accessory:FindFirstChild("Handle")

	if RootPart.Velocity.Magnitude < 50 then
		getgenv().OldPos = RootPart.CFrame
	end

	local function FPos(BasePart, Pos, Ang)
		RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
		Character:SetPrimaryPartCFrame(RootPart.CFrame)
		RootPart.Velocity = Vector3.new(9e7,9e7*10,9e7)
		RootPart.RotVelocity = Vector3.new(9e8,9e8,9e8)
	end

	local function SFBasePart(BasePart)
		local Angle = 0
		local Start = tick()
		repeat
			if not (THumanoid and THumanoid.Health > 0) then break end
			Angle += 120
			FPos(BasePart, CFrame.new(0,1.5,0), CFrame.Angles(math.rad(Angle),0,0))
			task.wait()
			FPos(BasePart, CFrame.new(0,-1.5,0), CFrame.Angles(math.rad(Angle),0,0))
			task.wait()
			FPos(BasePart, CFrame.new(2.5,1.5,-2.5), CFrame.Angles(math.rad(Angle),0,0))
			task.wait()
			FPos(BasePart, CFrame.new(-2.5,-1.5,2.5), CFrame.Angles(math.rad(Angle),0,0))
			task.wait()
		until BasePart.Velocity.Magnitude > 500 or tick() - Start > 2
	end

	workspace.FallenPartsDestroyHeight = 0/0

	local BV = Instance.new("BodyVelocity")
	BV.Parent = RootPart
	BV.Velocity = Vector3.new(9e8,9e8,9e8)
	BV.MaxForce = Vector3.new(1/0,1/0,1/0)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	if TRootPart then
		SFBasePart(TRootPart)
	elseif THead then
		SFBasePart(THead)
	elseif Handle then
		SFBasePart(Handle)
	end

	BV:Destroy()
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)

	repeat
		RootPart.CFrame = getgenv().OldPos
		Character:SetPrimaryPartCFrame(getgenv().OldPos)
		Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		for _, x in ipairs(Character:GetChildren()) do
			if x:IsA("BasePart") then
				x.Velocity = Vector3.zero
				x.RotVelocity = Vector3.zero
			end
		end
		task.wait()
	until (RootPart.Position - getgenv().OldPos.p).Magnitude < 20

	workspace.FallenPartsDestroyHeight = getgenv().FPDH
end

